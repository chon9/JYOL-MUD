  {"id": "bleed", "name": "流血", "kind": "DEBUFF", "glyph": "血", "color": "#c03030", "duration_actions": 4, "stack": "REFRESH", "blocks": [], "skip_actions": false, "random_action": false, "atk_mult": 1.0, "def_mult": 1.0, "gauge_mult": 1.0, "qi_pct_per_action": 0.0, "qi_pct_per_level": 0.0, "qi_pct_per_move": 0.0, "qi_max_pct_per_action": 0.03, "resist_by": [], "cure_by": ["MEDIC", "AUTO"], "persists": false, "persist_tick_real_s": 0, "persist_ticks_per_level": 0, "persist_qi_pct": 0.0, "since": "", "desc": "傷口流血不止，氣上限一直往下掉；敷藥（醫）可以止血。", "era": "1.0A", "src": "proposal",
