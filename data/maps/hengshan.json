    { "id": "hg_woodshed", "name": "柴房", "desc": "屋後堆著一捆捆劈好的木柴，屋旁林子裡有砍不完的枯枝。",
      "exits": [{"dir": "S", "to": "hg_kitchen"}], "npcs": ["n_hg_heyue"], "features": ["WOOD"], "requires": [] },
    { "id": "hg_houshan", "name": "恆山後山", "desc": "大殿後的山坡松柏蒼翠，山勢陡峭，弟子們在此打坐修定，也在峭壁間縱躍練輕功。西邊坡下開了幾畝菜田。",
      "exits": [{"dir": "S", "to": "hg_hall"}, {"dir": "W", "to": "hg_field"}],
