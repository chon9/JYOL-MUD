      ],
      "npcs": ["n_hg_yihe", "n_hg_spar"], "features": [], "requires": [] },
    { "id": "hg_hall", "name": "恆山大殿", "desc": "殿中供著觀音大士，香煙繚繞，木魚聲聲。掌門師太在此接見求師的女子，早晚課也在這裡做。",
      "exits": [{"dir": "S", "to": "hg_square"}, {"dir": "N", "to": "hg_houshan"}],
      "npcs": ["n_hg_dingxian", "n_hg_dingyi", "n_hg_yizhi"], "features": [], "requires": [] },
    {"id": "hg_first", "name": "第一間屋", "desc": "練劍坪西側的第一間屋子，靠牆擺滿藥櫃與晒乾的草藥。儀真師姊守在這裡，教弟子辨識藥材。", "exits": [{"dir": "E", "to": "hg_square"}], "npcs": ["n_hg_yizhen", "n_hg_lincai"], "features": [], "requires": []},
    { "id": "hg_kitchen", "name": "恆山灶房", "desc": "灶上蒸著素包子，于嫂一面揉麵一面唸佛。往北有一間柴房。",
      "exits": [{"dir": "W", "to": "hg_square"}, {"dir": "N", "to": "hg_woodshed"}], "npcs": ["n_hg_yusao"],
