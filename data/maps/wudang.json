      "requires": [{"type": "sect", "sect": "wudang"}] },
    { "id": "wd_siguo", "name": "思過處", "desc": "石壁圍成的小屋只有一扇鐵窗，觸犯門規的弟子被押到這裡面壁思過。執法道長守在門口。",
      "exits": [{"dir": "W", "to": "wd_houshan"}], "npcs": ["n_wd_jailer"], "features": [], "jail": true,
