      "npcs": ["n_wd_yudaiyan", "n_wd_spar", "n_wd_zhongfei"], "features": [], "requires": [] },
    { "id": "wd_daotian", "name": "稻田", "desc": "山腰開出的一片梯田，稻子長得正好，一位老農夫捲著褲管在田裡忙活。武當弟子平日也來幫忙耕作。",
      "exits": [{"dir": "E", "to": "wd_square"}], "npcs": ["n_wd_nongfu", "n_wd_nanyu"], "features": ["FIELD"],
      "requires": [{"type": "sect", "sect": "wudang"}] },
    { "id": "wd_shufang", "name": "書房", "desc": "書架上堆滿道經與字帖，案上筆墨未乾。四俠張松溪常在這裡教弟子寫書法、讀書識字。",
      "exits": [{"dir": "W", "to": "wd_square"}], "npcs": ["n_wd_zhangsongxi", "n_wd_xiyun"], "features": [],
      "requires": [{"type": "sect", "sect": "wudang"}] },
    { "id": "wd_dadian", "name": "大殿", "desc": "殿上供奉真武大帝，香煙繚繞，大俠宋遠橋端坐殿中處理派務。殿後有間小屋，東邊是三清宮。",
      "exits": [{"dir": "N", "to": "wd_square"}, {"dir": "S", "to": "wd_tanqiang"}, {"dir": "E", "to": "wd_sanqing"}],
      "npcs": ["n_wd_songyuanqiao", "n_wd_songqingshu"], "features": [],
