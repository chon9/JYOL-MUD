  "desc": "武當山上的武當派，張三丰真人在此開宗立派，門下七俠名震江湖。",
  "escape_tiles_hint": 2,
  "rooms": [
    { "id": "wd_gate", "name": "武當山門", "desc": "山門前的石階打掃得乾乾淨淨，知客道長在門口迎送香客，一旁的老先生正在簿子上記事。往南是練武場，往北下山的石階通往山腳。",
      "exits": [{"dir": "N", "to": "wd_road2"}, {"dir": "S", "to": "wd_square"}],
      "npcs": ["n_wd_cha", "n_wd_zhike", "n_wd_beizhong"], "features": [], "requires": [] },
    { "id": "wd_square", "name": "練武場", "desc": "青石鋪成的廣場上，武當弟子兩兩一組推手「抱太極」，一位中年道人在旁指點。南邊是大殿，東邊是書房，西邊是稻田。",
      "exits": [
