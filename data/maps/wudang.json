            [{"type": "quest_flag", "flag": "wd_recommended"}]
          ] }
      ] },
    { "id": "wd_tanqiang", "name": "大殿後屋", "desc": "大殿後頭的小屋，牆面被踩出一排排腳印，二俠俞蓮舟在這裡督促弟子練「踏牆」輕功。往南是後山。",
      "exits": [{"dir": "N", "to": "wd_dadian"}, {"dir": "S", "to": "wd_houshan"}], "npcs": ["n_wd_yulianzhou"],
      "features": [], "requires": [{"type": "sect", "sect": "wudang"}] },
    { "id": "wd_houshan", "name": "後山松林", "desc": "後山松林清幽，雲霧在林間繚繞，六俠殷梨亭與七俠莫聲谷常在此練功。林子東邊有間石屋。",
      "exits": [{"dir": "N", "to": "wd_tanqiang"}, {"dir": "E", "to": "wd_siguo"}],
