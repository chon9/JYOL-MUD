          {"monster": "m_bigrabbit", "w": 10, "count": [1, 1]}
        ] } },
    {"id": "dlw_desertcave", "name": "大理西沙漠洞窟", "desc": "洱海西岸的荒地裡有個幽深的洞窟，洞口沙土上留著雜亂的腳印。往東回洱海岸。", "exits": [{"dir": "E", "to": "dlw_lake"}], "npcs": ["n_dlw_guiyi"], "features": [], "requires": [], "encounter": {"rate": 0.1, "table": [{"monster": "m_wolf", "w": 60, "count": [1, 1]}, {"monster": "m_bandit", "w": 40, "count": [1, 1]}]}}
