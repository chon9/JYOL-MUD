    {"id": "xw_grass", "name": "荒草坡", "desc": "一大片及膝的枯草隨風起伏，草叢裡窸窸窣窣，看來藏了不少野兔，偶爾還有體型大上一倍的大野兔。北邊是胡楊林，南邊有條小溪，東邊的山丘傳來陣陣狼嚎。", "exits": [{"dir": "W", "to": "xw_road"}, {"dir": "N", "to": "xw_wood"}, {"dir": "S", "to": "xw_creek"}, {"dir": "E", "to": "xw_hill"}], "npcs": [], "features": ["HUNT"], "requires": [], "encounter": {"rate": 0.25, "table": [{"monster": "m_rabbit", "w": 70, "count": [1, 2]}, {"monster": "m_bigrabbit", "w": 30, "count": [1, 1]}]}, "hunt_table": [{"monster": "m_hunt_yetu", "w": 70}, {"monster": "m_hunt_dayetu", "w": 30}]},
    {"id": "xw_wood", "name": "胡楊林", "desc": "一片耐旱的胡楊林，枝幹虯結，地上散著枯枝，一位樵夫正揮刀砍柴。林子北邊有條小徑爬上山坡。", "exits": [{"dir": "S", "to": "xw_grass"}, {"dir": "N", "to": "xn_slope"}], "npcs": ["n_xw_woodcutter", "n_wd_zhaomin"], "features": ["WOOD"], "requires": [], "encounter": {"rate": 0.2, "table": [{"monster": "m_rabbit", "w": 100, "count": [1, 1]}]}},
    { "id": "xw_creek", "name": "小溪邊",
