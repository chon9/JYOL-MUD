  {
   "id": "q_jq_duanchang",
   "name": "斷腸崖",
   "chapter": "京城・絕情谷",
   "group": "jueqinggu",
   "giver": "n_jq_fanyiweng",
   "era": "1.0B",
   "src": "verified",
   "dialogue_src": "proposal",
   "src_note": "DIAO/2-2 預告「跳斷腸崖……是否又會發生小龍女當年的奇遇呢？」【已證實】；本作只做房間動作「望崖」、對白與一句傳聞，跳崖奇遇留 M3c（M3B_PLAN §8.3）；給予者樊一翁【設計提案】",
   "text": "絕情谷石屋後的斷腸崖深不見底，谷裡的人說，跳下去的從沒有回來過。",
   "requires": [],
   "give_items": [],
   "repeat": {
    "max": 1,
    "cooldown_days": 0
   },
   "abandon": true,
   "party_credit": false,
   "start": "s_cliff",
   "offer": "d_offer",
   "stages": [
