   ],
   "dialogues": {
    "d_offer": {
     "start": "n0",
     "nodes": {
      "n0": {
       "speaker": "npc",
       "text": "（一個面目清瘦的中年人起身拱手）在下公孫止，忝為本谷谷主。敝谷僻處深山，難得有客人到來。閣下一路穿過情花林，可曾被花刺刺著了？",
       "choices": [
        {
         "id": "c_ask",
         "label": "聽說谷主近日要辦喜事？",
         "goto": "n1"
        },
        {
         "id": "c_stay",
         "label": "多謝谷主，在下就叨擾幾日。",
         "do": [
          {
           "do": "accept"
          }
         ],
         "goto": "n_accept"
        },
        {
         "id": "c_no",
         "label": "誤闖寶地，這就告辭。",
         "goto": "n_no"
        }
       ]
      },
      "n1": {
       "speaker": "npc",
       "text": "（公孫止撚鬚微笑）閣下消息倒也靈通。前些日子我在谷外救了一位姑娘，她姓柳，我叫她柳妹。過幾日便要與她拜堂成親。",
       "choices": [
        {
         "id": "c_object",
         "label": "那位柳姑娘……可是心甘情願？",
         "goto": "n2"
        },
        {
         "id": "c_stay",
         "label": "恭喜谷主。在下就叨擾幾日，喝杯喜酒。",
         "do": [
          {
           "do": "accept"
          }
         ],
         "goto": "n_accept"
        }
       ]
      },
      "n2": {
       "speaker": "npc",
       "text": "（公孫止臉色一沉，隨即又和顏悅色）她親口答應過的，閣下多慮了。這是敝谷的家事，客人只管安心作客便是。",
       "goto": "n3"
      },
      "n3": {
       "speaker": "npc",
       "text": "敝谷規矩，不沾葷腥、不動相思之念，閣下記著些。小女綠萼在丹房看爐，有什麼需要，可以去找她。",
       "choices": [
        {
         "id": "c_stay",
         "label": "（暫且留下，再作打算）多謝谷主。",
         "do": [
          {
           "do": "accept"
          }
         ],
         "goto": "n_accept"
        },
        {
         "id": "c_no",
         "label": "既是家事，在下告辭。",
         "goto": "n_no"
        }
       ]
      },
      "n_accept": {
       "speaker": "npc",
       "text": "好。情花林的花刺有毒，十二個時辰之內莫動相思之念，否則痛入心脾。閣下在谷中走動，可別碰了不該碰的東西。",
       "goto": "END"
      },
      "n_no": {
       "speaker": "npc",
       "text": "（公孫止淡淡一笑）請便。樊一翁，送客。",
       "goto": "END"
      }
     }
    },
    "d_dan": {
     "start": "n0",
     "resume": "n0",
     "nodes": {
      "n0": {
       "speaker": "npc",
       "text": "（綠衫少女從爐邊抬起頭）你是爹爹新留的客人？丹房裡都是藥，你別亂碰。",
       "choices": [
        {
         "id": "c_ask",
         "label": "公孫姑娘，那位要和谷主成親的柳姑娘，人在哪裡？",
         "goto": "n1"
        },
        {
         "id": "c_bye",
         "label": "打擾了。",
         "goto": "END"
        }
       ]
      },
      "n1": {
       "speaker": "npc",
       "text": "（綠萼看了看門外，壓低聲音）柳姑娘被爹爹關在書房裡，說是讓她安心待嫁。可我瞧她一天到晚望著窗外，飯也不吃，哪裡像個要做新娘子的人。",
       "goto": "n2"
      },
      "n2": {
       "speaker": "npc",
       "text": "你身上帶著情花的刺傷吧？這是本谷的絕情丹，專解情花之毒。爹爹看得極緊，一人只能給一顆，你收好了，帶在身上，往後走過花林便不怕了。",
       "choices": [
        {
         "id": "c_take",
         "label": "多謝姑娘。",
         "do": [
          {
           "do": "give",
           "item": "c_jq_juequingdan",
           "n": 1
          },
          {
           "do": "complete",
           "obj": "o_dan"
          }
         ],
         "goto": "n3"
        }
       ]
      },
      "n3": {
       "speaker": "npc",
       "text": "書房在大廳東北邊。你去看看柳姑娘吧……千萬別讓爹爹知道是我給的丹藥。",
       "choices": [
        {
         "id": "c_ok",
         "label": "姑娘放心。",
         "goto": "END"
        }
       ]
      }
     }
    },
    "d_liumei": {
     "start": "n0",
     "resume": "n0",
     "nodes": {
      "n0": {
       "speaker": "npc",
       "text": "（白衣少女背對著門，聲音冷冷淡淡）你是誰？谷主讓你來的？",
       "choices": [
        {
         "id": "c_who",
         "label": "是公孫姑娘讓我來看妳的。妳……真想嫁給谷主？",
         "goto": "n1"
        },
        {
         "id": "c_leave",
         "label": "走錯房間了，告辭。",
         "goto": "END"
        }
       ]
      },
      "n1": {
       "speaker": "npc",
       "text": "我姓柳。那日我昏倒在谷外，是谷主救了我。他要我嫁他，我……我心灰意冷，便答應了。",
       "goto": "n2"
      },
      "n2": {
       "speaker": "npc",
       "text": "可我心裡，一直記著一個人。他若知道了，不知會有多傷心。（她轉過頭去，不再說下去）",
       "goto": "n3"
      },
      "n3": {
       "speaker": "npc",
       "text": "前幾夜我聽見北邊書架後頭，有人在地底下又哭又罵，聲音蒼老淒厲。那書架後有道暗門，谷主從不許人碰。你若真要幫我，先下去看看——那人或許知道怎麼對付谷主。",
       "choices": [
        {
         "id": "c_go",
         "label": "好，我下去看看，妳等我回來。",
         "do": [
          {
           "do": "complete",
           "obj": "o_liumei"
          }
         ],
         "goto": "END"
        }
       ]
      }
     }
    },
    "d_qiu": {
     "start": "n0",
     "resume": "n0",
     "nodes": {
      "n0": {
       "speaker": "npc",
       "text": "（禿頭老婦猛地抬起頭，雙目精光四射）誰？是公孫止那狗賊派你來害老婆子的？",
       "choices": [
        {
         "id": "c_no",
         "label": "前輩誤會了。我是來救書房裡那位柳姑娘的。",
         "goto": "n1"
        },
        {
         "id": "c_leave",
         "label": "（悄悄退出石洞）",
         "goto": "END"
        }
       ]
      },
      "n1": {
       "speaker": "npc",
       "text": "柳姑娘？嘿嘿，嘿嘿……那狗賊又要娶新人了？老婆子是他的原配妻子裘千尺！當年他與賤婢私通，被我撞破，他便暗算我，挑斷我手足筋脈，把我丟進這鱷魚潭裡。",
       "goto": "n2"
      },
      "n2": {
       "speaker": "npc",
       "text": "我命大，沒餵了鱷魚，靠著洞頂落下來的棗子，硬是活到今天。他手上那點絕情丹，配方還是我裘家的！他道我早死了，哪知老婆子天天在這底下數著日子。",
       "goto": "n3"
      },
      "n3": {
       "speaker": "npc",
       "text": "你聽好：這石洞有條谷底秘道，沿著潭邊往回走，在暗門底下有個機括，從下面一推便開，那狗賊每天這時辰在劍房練劍，聽不見書房的動靜。你快帶那姑娘出谷，莫要被他瞧見！",
       "choices": [
        {
         "id": "c_thanks",
         "label": "多謝前輩指點。",
         "do": [
          {
           "do": "var",
           "name": "mitao",
           "value": true
          },
          {
           "do": "complete",
           "obj": "o_qiu"
          }
         ],
         "goto": "n4"
        }
       ]
      },
      "n4": {
       "speaker": "npc",
       "text": "出了谷，替老婆子在江湖上傳一句話——公孫止，你的報應就要到了！",
       "goto": "END"
      }
     }
    },
    "d_go": {
     "start": "n0",
     "resume": "n0",
     "nodes": {
      "n0": {
       "speaker": "npc",
       "text": "（柳姑娘見你從暗門爬上來，微微一怔）你回來了。底下那人……是誰？",
       "choices": [
        {
         "id": "c_go",
         "label": "說來話長。柳姑娘，跟我走，現在就出谷！",
         "do": [
          {
           "do": "escort_start",
           "npc": "n_jq_liumei"
          },
          {
           "do": "complete",
           "obj": "o_back"
          }
         ],
         "goto": "n1"
        },
        {
         "id": "c_wait",
         "label": "（先等一等，準備好再走）",
         "goto": "END"
        }
       ]
      },
      "n1": {
       "speaker": "npc",
       "text": "（她沉默片刻，輕輕點頭）……好。我本就不該留在這裡。",
       "goto": "END"
      }
     }
    }
   },
