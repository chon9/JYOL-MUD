 "quests": [
  {
   "id": "q_ec_biao_xx_dl",
   "name": "保鏢：西夏往大理",
   "chapter": "鏢局・保鏢",
   "group": "_econ",
   "giver": "n_ec_xx_biaotou",
   "era": "1.0A",
   "src": "proposal",
   "src_note": "官方鏢局頁：保鏢與驛站送信皆能提升名聲值（研究 經濟）；丐幫不能運鏢（2001 多篇，O17）；路線、酬勞、冷卻【設計提案】（M3B_PLAN §5.2.3、§10）",
   "text": "西夏的鏢局有一趟鏢要送往大理，缺個武藝過得去的人押車。把鏢車平平安安護送到大理的鏢局，就有酬勞。",
   "requires": [
    {
     "type": "sect_not",
     "sect": "gaibang"
    }
   ],
   "give_items": [],
   "repeat": {
    "max": 0,
    "cooldown_days": 1
   },
   "abandon": true,
   "party_credit": true,
   "start": "s_go",
   "stages": [
    {
     "id": "s_go",
     "title": "押鏢到大理",
     "log": "鏢車跟在你身後，別走散了。出西夏東門到東門外官道，往東上荒草坡，往南經小溪邊、南坡，西南到溪口淺灘，再一路往南穿過大漠邊緣，東南經綠洲、河川上游，順著河川古道過河灣、過河石橋，到城北河畔往南進大理北門，五華樓前往東北就是大理鏢局。",
     "hint_room": "dl_biaoju",
     "on_enter": [
      {
       "do": "escort_start",
       "npc": "n_ec_biaoche"
      }
     ],
     "objectives": [
      {
       "id": "o_go",
       "type": "ESCORT",
       "npc": "n_ec_biaoche",
       "to_room": "dl_biaoju",
       "text": "把鏢車護送到大理的鏢局"
      }
     ],
     "on_complete": [
      {
       "do": "escort_end",
       "npc": "n_ec_biaoche"
      }
     ],
     "next": "END"
    }
   ],
   "outcomes": {
    "default": {
     "label": "鏢已送達",
     "rewards": {
      "money": 150,
      "fame": 3
     },
