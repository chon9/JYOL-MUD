 "text_templates": [
  {
   "id": "talk_n_ec_xx_banker",
   "era": "1.0A",
   "self": "錢莊掌櫃抬起頭：「客官要存錢還是存東西？本號在大理、京城都有分號，帳目相通。」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_dl_banker",
   "era": "1.0A",
   "self": "錢莊掌櫃推了推眼鏡：「存在西夏的東西，這裡一樣領得到。任務的東西、身上穿戴的，可不收。」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_jc_banker",
   "era": "1.0B",
   "self": "錢莊大掌櫃拱手：「京城錢莊，信譽第一。存放分文不取，東西放多久都跟剛存進來一樣。」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_xx_biaotou",
   "era": "1.0A",
   "self": "鏢頭拍了拍鏢車：「要托鏢寄東西給朋友，還是想跟著押一趟鏢賺點銀子？丐幫的兄弟就免了，規矩如此。」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_dl_biaotou",
   "era": "1.0A",
   "self": "鏢頭笑道：「往西夏的路上要過大漠，貨交給我們最穩當。押鏢的人手也一直缺。」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_jc_biaotou",
   "era": "1.0B",
   "self": "總鏢頭沉聲道：「中華鏢局走遍南北，從沒丟過一趟鏢。你要寄貨，還是要押鏢？」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_xx_tangzi",
   "era": "1.0B",
   "self": "趟子手興沖沖地說：「京城那條線剛開，路是遠了點，酬勞可比跑大理多！」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_dl_tangzi",
   "era": "1.0B",
   "self": "趟子手嘆口氣：「從大理到京城得翻好幾座山，有人押車就安心多了。」",
   "src": "proposal"
  },
  {
   "id": "talk_n_ec_biaoche",
   "era": "1.0A",
   "self": "鏢車的騾子打了個響鼻，車輪吱呀作響。",
   "src": "proposal"
  },
  {
   "id": "bank_put",
   "era": "1.0A",
   "self": "你把{item_name} ×{n}交給{npc_name}存進錢莊。",
   "src": "proposal"
