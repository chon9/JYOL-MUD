  "exit_patches": [
    { "room": "xx_gate_e", "add_exits": [{"dir": "S", "to": "xx_minfang"}],
      "desc": "厚重的城門下站著守衛，城門邊的老先生正提筆記帳。城門南邊是一排民房；出了城門往東是郊外：往東北的官道去恆山、華山、少林，順著南邊的小溪往南可以走到大理。" },
    { "room": "xx_square", "add_exits": [{"dir": "NW", "to": "xx_yamen"}],
      "desc": "西夏城中心的廣場，黃土地面被往來的駱駝商隊踩得結實。東邊是城門，北邊是客棧，南邊是驛站，西邊通往熱鬧的西大街，西北是衙門。" },
    { "room": "xx_street", "add_exits": [{"dir": "NW", "to": "xx_palace"}],
      "desc": "西大街兩旁店鋪林立，北邊是藥鋪，南邊是兵器鋪，西邊傳來武館弟子操練的吆喝聲，西北通往皇宮門口。路邊站著兩個神色古怪的人。" },
    { "room": "sl_court", "add_exits": [{"dir": "NW", "to": "sl_leftroom"}],
      "desc": "青石鋪成的前院打掃得一塵不染，古柏森森。西邊是練武場，東邊是齋堂，北邊是大雄寶殿，西北角是山門左廂房。" },
    { "room": "hs_hall", "add_exits": [{"dir": "N", "to": "hs_siguoya"}],
      "desc": "堂上懸著「正氣」二字，是華山派議事與傳授武藝的地方，只有本門弟子可以進入。堂後有條小路往北通到思過崖。" },
    { "room": "dlw_lake", "add_exits": [{"dir": "W", "to": "dlw_desertcave"}],
      "desc": "洱海湖水碧藍，岸邊停著幾艘漁船，是垂釣的好地方。往西的荒地裡有個沙漠洞窟。" },
    { "room": "rr_bend", "add_exits": [{"dir": "E", "to": "rr_eastbank"}],
      "desc": "河在這裡繞了個大彎，水流緩慢，是釣魚的好地方。往東是遠望雪山的東岸。" },
    { "room": "wd_road1", "add_exits": [{"dir": "SE", "to": "hn_road1"}],
      "desc": "從嵩山古道岔出來的山路，崩落的巨石推到了路邊，石階上偶有道童往來。往西有條小徑鑽進樹林，往南就是武當山腳，往東南的衡陽古道通往衡山。" },
    { "room": "hf_fork", "add_exits": [{"dir": "NE", "to": "ym_road"}],
      "desc": "官道在這裡分岔。往北的山路通往恆山派；往東北的古道已經通了，一路可到雁門關。往東南是去華山的華陰道。" }
  ],
