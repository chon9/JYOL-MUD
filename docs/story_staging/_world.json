      "rooms": [
        { "id": "hn_road1", "name": "衡陽古道", "desc": "古道離開武當山腳往東南伸去，兩旁是竹林與茶園。往西北回武當山下，往南可到湘江渡口。",
          "exits": [{"dir": "NW", "to": "wd_road1"}, {"dir": "S", "to": "hn_road2"}], "npcs": [], "features": [], "requires": [],
          "encounter": { "rate": 0.1, "table": [
            {"monster": "m_bigrabbit", "w": 80, "count": [1, 1]}, {"monster": "m_wolf", "w": 15, "count": [1, 1]}, {"monster": "m_boar", "w": 5, "count": [1, 1]} ] } },
        { "id": "hn_road2", "name": "湘江渡口", "desc": "江面寬闊，渡船往來不絕，船家吆喝著招呼過客。往北回衡陽古道，往南過了江就是衡山腳下。",
          "exits": [{"dir": "N", "to": "hn_road1"}, {"dir": "S", "to": "hn_foot"}], "npcs": [], "features": ["WATER"], "requires": [],
          "encounter": { "rate": 0.1, "table": [
            {"monster": "m_bigrabbit", "w": 80, "count": [1, 1]}, {"monster": "m_wolf", "w": 15, "count": [1, 1]}, {"monster": "m_boar", "w": 5, "count": [1, 1]} ] } }
      ] },
    "hengshan_s": { "region_id": "hengshan_s", "era": "1.0A", "src": "proposal", "escape_tiles_hint": 2,
      "desc": "南嶽衡山，七十二峰連綿，衡山派劉正風便住在山下。",
      "rooms": [
        { "id": "hn_foot", "name": "衡山下", "desc": "衡山腳下有一方池塘，岸邊幾個衡山弟子在迎送賓客。往北回湘江渡口，往東是小茶店，東北是上山路口，東南有座石橋。",
          "exits": [{"dir": "N", "to": "hn_road2"}, {"dir": "E", "to": "hn_teahouse"}, {"dir": "NE", "to": "hn_shore"}, {"dir": "SE", "to": "hn_bridge"}],
          "npcs": [], "features": ["WATER"], "requires": [], "safe": true,
          "encounter": { "rate": 0.08, "table": [
