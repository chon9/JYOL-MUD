        { "id": "hn_teahouse", "name": "衡山小茶店", "desc": "路邊一間小茶店，竹桌竹凳，往來的江湖人都在這裡歇腳打聽消息。往西出門就是衡山下。",
          "exits": [{"dir": "W", "to": "hn_foot"}], "npcs": [], "features": [], "requires": [], "safe": true },
        { "id": "hn_shore", "name": "上山路口海邊", "desc": "上山的路口緊挨著一大片水面，黃昏時常有胡琴聲從水邊傳來。往西南回衡山下。",
          "exits": [{"dir": "SW", "to": "hn_foot"}], "npcs": [], "features": ["WATER"], "requires": [],
          "encounter": { "rate": 0.08, "table": [ {"monster": "m_rabbit", "w": 100, "count": [1, 1]} ] } },
        { "id": "hn_bridge", "name": "小島石橋", "desc": "一道窄窄的石橋通往池塘中的小島，橋面長滿青苔。往西北回衡山下，往南過橋上島。",
          "exits": [{"dir": "NW", "to": "hn_foot"}, {"dir": "S", "to": "hn_island"}], "npcs": [], "features": [], "requires": [],
          "encounter": { "rate": 0.05, "table": [ {"monster": "m_rabbit", "w": 100, "count": [1, 1]} ] } },
        { "id": "hn_island", "name": "衡山下方小島", "desc": "小島上幾株老柳，柳下一塊大石，像是常有人在這裡打坐養傷。往北過橋回岸上。",
          "exits": [{"dir": "N", "to": "hn_bridge"}], "npcs": [], "features": [], "requires": [], "safe": true }
      ] },
    "yanmen": { "region_id": "yanmen", "era": "1.0A", "src": "proposal", "escape_tiles_hint": 2,
      "desc": "北方雄關雁門關，關外風沙漫天，商旅往來都要在這裡歇一口氣。",
      "rooms": [
        { "id": "ym_road", "name": "雁門古道", "desc": "從恆山岔路往東北延伸的古道，越走越荒涼，北風捲著黃沙。往西南回恆山岔路，往北就是雁門關口。",
          "exits": [{"dir": "SW", "to": "hf_fork"}, {"dir": "N", "to": "ym_gate"}], "npcs": [], "features": [], "requires": [],
