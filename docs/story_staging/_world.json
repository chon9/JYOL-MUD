            {"monster": "m_bigrabbit", "w": 60, "count": [1, 1]}, {"monster": "m_wolf", "w": 35, "count": [1, 1]}, {"monster": "m_bandit", "w": 5, "count": [1, 1]} ] } },
        { "id": "ym_gate", "name": "雁門關口", "desc": "雄關聳立，城樓上旌旗獵獵。關口邊擺著幾個商販的攤子。往南回雁門古道，往北進關，東南出關有座小橋。",
          "exits": [{"dir": "S", "to": "ym_road"}, {"dir": "N", "to": "ym_inner"}, {"dir": "SE", "to": "ym_bridge"}], "npcs": [], "features": [], "requires": [], "safe": true,
