        { "id": "ym_bridge", "name": "關外橋邊", "desc": "關外一座木橋橫跨乾涸的河床，常有歹人在橋下埋伏過路的商旅。往西北回雁門關口。",
          "exits": [{"dir": "NW", "to": "ym_gate"}], "npcs": [], "features": [], "requires": [],
          "encounter": { "rate": 0.1, "table": [
            {"monster": "m_wolf", "w": 50, "count": [1, 1]}, {"monster": "m_bandit", "w": 50, "count": [1, 1]} ] } },
        { "id": "ym_inner", "name": "雁門關內", "desc": "關內一條長街，酒旗招展，戍邊的軍士與南來北往的豪客擠在一起喝酒。往南出關口。",
          "exits": [{"dir": "S", "to": "ym_gate"}], "npcs": [], "features": [], "requires": [], "safe": true }
      ] }
