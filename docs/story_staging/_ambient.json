    },
    {
      "id": "rx_refuse_evil",
      "era": "1.0A",
      "self": "{npc_name}擺擺手：「你這種惡名在外的人，小店不做你的生意。」",
      "src": "proposal"
    },
    {
      "id": "rx_refuse_saint",
      "era": "1.0A",
      "self": "{npc_name}冷笑：「正道大俠的銀子，我們可不敢收。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_amb_etou",
      "era": "1.0A",
      "self": "{npc_name}橫眉豎目地瞪著你：「看什麼看？把值錢的東西留下！」",
      "src": "proposal"
    },
    {
      "id": "talk_n_amb_etou@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}在黑暗中獰笑：「三更半夜還敢在這條路上走？」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wujieshan@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}打了個呵欠：「天都黑了，荒草坡上的野兔也該睡了吧……大兔皮的事，明天再說。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_zhangwuji@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}倚著窗望向夜色：「夜裡行路要多加小心，聽說城外不太平。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_chenjialuo@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}仰頭望著滿天星斗：「大漠的夜空，倒是比江南清朗得多。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xe_miner@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}提著油燈：「夜裡礦坑裡的怪聲更大了，我可不敢再往下走。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_dl_bukuai@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}揉著眼睛：「夜裡還得巡街，剿匪的事明早再議吧。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_weixiaobao@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}打著哈欠：「這麼晚了還不睡？要不要來擲兩把骰子？」",
      "src": "proposal"
    },
    {
      "id": "talk_n_shuanger@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}輕聲說：「相公睡下了，您小聲些。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_taoyun@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}坐在田埂上歇腳：「天黑了，稻子也該歇歇了。明天一早再來吧。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_beimianyi@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}提著燈籠巡夜：「這麼晚了還在外頭？師父知道了可要罰的。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_dingminjun@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}冷哼一聲：「大半夜的不去練功，到處亂逛做什麼？」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_zhouzhiruo@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}在燈下抄經：「夜深了，師姐也早點歇息吧。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_jingguan@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}望著窗外的月亮出神：「每到這樣的夜裡，就會想起師伯……」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_lianxiang@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}閉目打坐：「夜裡最宜靜心。坐下來，一起禪修吧。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_jinxiaomei@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}揉著肚子：「廚房的灶火都熄了……師姐，你身上有沒有吃的？」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_jianchi@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}抱著劍縮在山腳下：「冷凝劍……夜裡也冷，劍也冷……」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_jixiaofu@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}望著黑沉沉的林子：「這麼晚了……他今天大概不會來了。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_em_yingyueer@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}托著腮望向門外：「天都黑了……茶都涼了。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_lj_chengqingshuang@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}放下手中的紡錘：「夜裡風大，師妹多添件衣裳。有什麼心事，不妨跟我說說。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_lj_fuminyi@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}裹著棉被直打哆嗦：「夜裡更冷了……哈啾！」",
      "src": "proposal"
    },
    {
      "id": "talk_n_qz_lizhichang@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}收起木劍：「天黑了，切磋明天再來吧。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_qz_biye@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}就著油燈看書：「出師的事，白天再談。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_qz_huipai@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}打了個呵欠：「登記的事，明天再說吧。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_qz_dongkou@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}壓低聲音：「再等等，子時一到，洞裡就……噓，別出聲。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_qz_zhangyuan@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}提著燈籠在菜園裡巡看：「夜裡菜蟲最多，我得盯著些。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_qz_chendabao@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}在河邊來回踱步：「唉，又是一夜睡不著……」",
      "src": "proposal"
    },
    {
      "id": "talk_n_qz_chengfeng@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}抱著酒葫蘆躺在路邊：「月亮……嘿，月亮也喝醉了，晃來晃去的。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_beizhong@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}按著劍柄：「夜裡山門不開，有事明早再來。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_yinjian@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}拱手道：「天色已晚，拜山的事明日再談不遲。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_zhongfei@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}擦著劍：「師兄弟們都歇下了，練武場明天見。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_nongfu@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}扛著鋤頭往回走：「天黑了，田裡的事明天再說。插秧要直，記得啊！」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_nanyu@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}捶著腰：「總算收工了……腰都直不起來了。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_xiyun@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}在燈下臨帖：「夜裡寫字最能靜心，四師叔說的。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_songqingshu@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}負手而立：「夜深了，有事明日再稟。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_dongchao@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}望著南方出神：「大理那邊這時候……爹大概已經睡了吧。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_wd_dl_oldman@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}咳了幾聲：「人老了，夜裡睡不著，總惦記著山上的孩子。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xh_chuchenzi@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}抱著瓦罐嘿嘿直笑：「夜裡毒蛇最多，正是捉蛇的好時候。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xh_shudouzi@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}點起火把：「夜裡蟾蜍都出來了，捉毒物正是時候。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xh_tianlangzi@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}盯著鼎下的火：「這毒得熬上一整夜，別來打擾我。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xd_shanyong@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}在火堆旁磨刀：「夜裡最適合清理門戶。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xd_aihui@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}陰惻惻地看著你：「天黑了……你還不走？」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xd_buliu@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}抱著胳膊靠在柱子上打盹：「出師的事，等天亮再說。」",
      "src": "proposal"
    },
    {
      "id": "talk_n_xd_buzou@NIGHT",
      "era": "1.0A",
      "self": "{npc_name}懶洋洋地翻了個身：「大半夜的，別吵。」",
      "src": "proposal"
    },
    {
      "id": "amb_g_xx_inn_news",
      "era": "1.0A",
      "self": "鄰桌幾個江湖客壓低了聲音說話，客棧向來是打聽消息的好地方。",
      "src": "proposal"
    },
    {
      "id": "amb_g_dl_inn_news",
      "era": "1.0A",
      "self": "櫃檯邊有人在談論最近江湖上的新鮮事，店小二豎著耳朵聽得入神。",
      "src": "proposal"
    },
    {
      "id": "amb_g_xx_night",
      "era": "1.0A",
      "self": "夜深了，西夏城裡的燈火一盞盞熄滅，街上只剩巡夜的梆子聲。",
      "src": "proposal"
    },
    {
      "id": "amb_g_dl_night",
      "era": "1.0A",
      "self": "大理城入夜後格外安靜，遠處五華樓上還亮著幾點燈火。",
      "src": "proposal"
    },
    {
      "id": "amb_g_xx_dawn",
      "era": "1.0A",
      "self": "天剛濛濛亮，廣場上已經有人在打拳練功了。",
      "src": "proposal"
    },
    {
      "id": "amb_g_xx_street_night",
      "era": "1.0A",
      "self": "街角兩個小販交頭接耳：「天一黑，那兩個惡人就出城去了……」",
      "src": "proposal"
    },
    {
      "id": "amb_g_xx_street_day",
      "era": "1.0A",
      "self": "路人遠遠繞過街心，生怕惹上那兩個煞星。",
      "src": "proposal"
    },
    {
      "id": "amb_g_hf_teaman_road",
      "era": "1.0A",
      "self": "茶棚老闆一邊擦桌子一邊說：「客官打哪兒來？這幾天路上不太平，天黑前最好找個地方落腳。」",
      "src": "proposal"
    },
    {
      "id": "amb_g_sy_teaman_road",
      "era": "1.0A",
      "self": "茶棚老闆替你斟了碗茶：「往東過了松林就是少室山；岔路往南上去，就是武當山了。」",
      "src": "proposal"
    },
    {
      "id": "amb_g_em_teaman_road",
      "era": "1.0A",
      "self": "茶棚老闆指著山道：「再往上走就是峨嵋山腳了，林子裡有山賊，可別一個人亂闖。」",
      "src": "proposal"
    },
    {
      "id": "amb_g_wd_nongfu_nag",
      "era": "1.0A",
      "self": "老農夫又叮嚀了一遍：「插秧要直，水別放太滿……我剛才說過了？那就再說一遍。」",
      "src": "proposal"
    },
    {
      "id": "amb_g_taoyun_nag",
      "era": "1.0A",
      "self": "陶耘彎著腰念叨：「稻子怕旱也怕澇，老天爺可得幫幫忙啊。」",
      "src": "proposal"
    },
    {
      "id": "amb_g_dl_scholar",
      "era": "1.0A",
      "self": "一個落第秀才拉住路人的衣袖：「借、借幾文盤纏，來年中了舉一定加倍奉還……」",
      "src": "proposal"
    },
    {
      "id": "amb_g_xw_night",
      "era": "1.0A",
      "self": "荒野裡傳來幾聲狼嚎，夜風吹得草叢沙沙作響。",
      "src": "proposal"
    },
    {
      "id": "amb_g_ws_night",
      "era": "1.0A",
      "self": "遠處的沙丘上似乎有個人影一晃而過，懷裡像是抱著什麼東西……",
      "src": "proposal"
    },
    {
      "id": "amb_g_xe_mine_night",
      "era": "1.0A",
      "self": "礦坑深處傳來一陣陣怪聲，礦工阿火縮了縮脖子。",
      "src": "proposal"
    },
    {
      "id": "amb_g_dlw_dusk",
      "era": "1.0A",
      "self": "夕陽沉進洱海，稻田邊的農人扛著鋤頭收工回家了。",
      "src": "proposal"
    },
    {
      "id": "amb_g_xx_pharmacy",
      "era": "1.0A",
      "self": "藥鋪裡瀰漫著一股苦澀的藥香。",
      "src": "proposal"
    }
  ],
