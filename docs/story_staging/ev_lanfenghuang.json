{
  "fragment": "ev_lanfenghuang", "version": 1, "author": "WP-C-ev_lanfenghuang",
  "quests": [
    { "id": "q_lanfeng", "name": "藍鳳凰採收毒物", "chapter": "雪山東岸・藍鳳凰採收毒物", "group": "ev_lanfenghuang",
      "giver": "n_lf_lanfenghuang", "era": "1.0A", "src": "verified", "dialogue_src": "proposal",
      "src_note": "研究 藍鳳凰採收毒物／藍鳳凰事件：17173 tishi 2001-07-18（藍鳳凰採收毒物）、2001-08-10（藍鳳凰事件，併入本任務的獎勵分支）；攻略 2001-7-21 n528_445091（flourx）、2001-8-2 n820_736977、2001-8-20 n453_369347。官方 TW 站無此文，日期以 17173 為準（D1）。福緣 22 門檻、1 遊戲日等待與冷卻：台免（src later）",
      "text": "藍鳳凰急欲製造五寶花蜜酒，因而一直在收集其所需之五毒。在幫藍鳳凰收集五毒的途中，又得知幫忙收集五毒的瑩月兒，原來跟華山派的藍依涵是多年的好友。在收集散落在廣大江湖中的毒物同時，也幫幫瑩月兒吧。",
      "requires": [ { "type": "attr_min", "attr": "luck", "value": 22 } ],
      "give_items": [],
      "repeat": { "max": 0, "cooldown_days": 1 },
      "abandon": true, "party_credit": true,
      "start": "s_collect",
      "offer": "d_offer",
      "stages": [
        { "id": "s_collect", "title": "五毒各五隻",
          "log": "藍鳳凰要蜈蚣、青蛇、蝎子、蜘蛛、蟾蜍各五隻，抓到的毒物會放在物品的「其他」欄。蜈蚣：從雪山東岸往西回河灣，沿河川古道往北到河川上游。青蛇：從河灣往南過石橋，到大理城北河畔。蝎子：從河川上游往西北經綠洲、沙漠山洞外，往北過大漠邊緣到沙丘邊緣，往西走蛇骨小徑，再往南就是毒沼。蜘蛛：出西夏東門，經東門外官道往東北，過礦區、黑龍潭、潭東河岸到恆山外稻田，再一路往東經路邊茶棚、恆山岸邊到恆山岔路。這四處都要各打五場。蟾蜍：出大理北門往東，經陶耘稻田、東邊樹林、崆峒道口，過崆峒橋、竹林山徑，到峨嵋茶棚找瑩月兒。",
          "hint_room": "rr_upper",
          "on_enter": [ { "do": "var", "name": "toad", "value": "start" } ],
          "objectives": [
            { "id": "o_wugong", "type": "COLLECT", "item": "r_lf_wugong", "count": 5, "text": "到河川上游抓 5 隻蜈蚣" },
            { "id": "o_qingshe", "type": "COLLECT", "item": "r_lf_qingshe", "count": 5, "text": "到大理城北河畔抓 5 條青蛇" },
            { "id": "o_xiezi", "type": "COLLECT", "item": "r_lf_xiezi", "count": 5, "text": "到星宿毒沼抓 5 隻蝎子" },
            { "id": "o_zhizhu", "type": "COLLECT", "item": "r_lf_zhizhu", "count": 5, "text": "到恆山岔路抓 5 隻蜘蛛" },
            { "id": "o_yingyueer", "type": "TALK", "npc": "n_em_yingyueer", "dialogue": "d_ying", "text": "到峨嵋茶棚找瑩月兒要蟾蜍" },
            { "id": "o_lanyihan", "type": "TALK", "npc": "n_hs_lanyihan", "dialogue": "d_lanyihan", "text": "把瑩月兒的麻布送到華山玉女峰練武場給藍依涵" },
            { "id": "o_chanchu", "type": "COLLECT", "item": "r_lf_chanchu", "count": 5, "text": "帶著瑩月兒給的 5 隻蟾蜍" }
          ],
          "room_actions": [
            { "id": "a_wugong", "room": "rr_upper", "label": "捕捉蜈蚣", "hours": [], "requires": [], "repeat": true,
              "do": [ { "do": "tell", "key": "lf_tell_wugong" }, { "do": "fight", "monsters": ["m_lf_wugong"], "obj": "" } ] },
            { "id": "a_qingshe", "room": "dlw_river", "label": "捕捉青蛇", "hours": [], "requires": [], "repeat": true,
              "do": [ { "do": "tell", "key": "lf_tell_qingshe" }, { "do": "fight", "monsters": ["m_lf_qingshe"], "obj": "" } ] },
            { "id": "a_xiezi", "room": "xh_marsh", "label": "捕捉蝎子", "hours": [], "requires": [], "repeat": true,
              "do": [ { "do": "tell", "key": "lf_tell_xiezi" }, { "do": "fight", "monsters": ["m_lf_xiezi"], "obj": "" } ] },
            { "id": "a_zhizhu", "room": "hf_fork", "label": "捕捉蜘蛛", "hours": [], "requires": [], "repeat": true,
              "do": [ { "do": "tell", "key": "lf_tell_zhizhu" }, { "do": "fight", "monsters": ["m_lf_zhizhu"], "obj": "" } ] }
          ],
          "next": "s_wait" },
        { "id": "s_wait", "title": "等花蜜釀好",
          "log": "五毒都抓齊了。藍鳳凰說過，酒罈裡的花蜜得先釀上一日，五寶才下得進去。過一個遊戲日之後，帶著五毒回雪山東岸找她（從大理出北門往北過石橋到河灣，往東就是雪山東岸）。",
          "hint_room": "rr_eastbank",
          "on_enter": [ { "do": "tell", "key": "lf_tell_allfive" } ],
          "objectives": [
            { "id": "o_wait", "type": "WAIT", "days": 1, "text": "等一個遊戲日，讓花蜜釀好" }
          ],
          "next": "s_return" },
        { "id": "s_return", "title": "五寶花蜜酒",
          "log": "花蜜該釀好了。帶著蜈蚣、青蛇、蝎子、蜘蛛、蟾蜍各五隻，回雪山東岸交給藍鳳凰（從大理出北門往北過石橋到河灣，往東就是雪山東岸）。",
          "hint_room": "rr_eastbank",
          "on_enter": [ { "do": "tell", "key": "lf_tell_ready" } ],
          "objectives": [
            { "id": "o_return", "type": "TALK", "npc": "n_lf_lanfenghuang", "dialogue": "d_return", "text": "把五毒交給雪山東岸的藍鳳凰" }
          ],
          "next": [ { "if": [ { "type": "sect", "sect": "hengshan" } ], "goto": "END:hengshan" },
                    { "goto": "END:default" } ] }
      ],
      "dialogues": {
        "d_offer": { "start": "n0", "nodes": {
          "n0": { "speaker": "npc",
                  "src_note": "依據 17173 tishi 2001-07-18 簡介「藍鳳凰急欲製造五寶花蜜酒，因而一直在收集其所需之五毒」；五寶花蜜酒、令狐沖喝酒典出《笑傲江湖》五霸岡；對白【設計提案】",
                  "text": "那苗家打扮的女子赤著雙足坐在河岸大石上，耳垂的銀環叮叮噹噹地響：「喂，你這人站在那裡瞧我做什麼？我是五毒教的藍鳳凰。我正要釀一罈五寶花蜜酒，偏偏五樣寶貝還差得遠呢。」",
                  "choices": [ { "id": "c_ask", "label": "什麼是五寶花蜜酒？", "goto": "n1" },
                               { "id": "c_bye", "label": "姑娘慢忙，在下告辭。", "goto": "END" } ] },
          "n1": { "speaker": "npc",
                  "text": "「五寶就是五毒：蜈蚣、青蛇、蝎子、蜘蛛、蟾蜍。把這五樣寶貝浸進花蜜酒裡，喝了大補，百毒不侵。從前令狐大哥起先也不敢喝，後來還不是一口氣喝了好幾碗，咯咯。」",
                  "choices": [ { "id": "c_more", "label": "這五樣寶貝要上哪兒找？", "goto": "n2" } ] },
          "n2": { "speaker": "npc",
                  "text": "「每樣我要五隻，要活生生、毒性足的。雪山北邊的河川上游爛泥裡有蜈蚣；大理城北河畔的草叢裡有青蛇；星宿海那邊的毒沼裡蝎子多得是；恆山岔路的石縫裡，結網的蜘蛛又大又毒。」",
                  "choices": [ { "id": "c_toad", "label": "那蟾蜍呢？", "goto": "n3" } ] },
          "n3": { "speaker": "npc",
                  "text": "「蟾蜍嘛，我託了瑩月兒那丫頭去抓，她在峨嵋茶棚歇腳，你去找她拿便是。對了，酒罈裡的花蜜得先釀上一日，你抓齊了，隔一日再拿來給我。你肯不肯幫我這個忙？」",
                  "choices": [ { "id": "c_help", "label": "好，這個忙我幫了。", "do": [ { "do": "accept" } ], "goto": "n_yes" },
                               { "id": "c_no", "label": "毒物這種東西，我可不敢碰。", "goto": "n_no" } ] },
          "n_yes": { "speaker": "npc",
                     "text": "「你這人很好。抓的時候小心，別讓牠們咬了；真咬了也別怕，回來我給你解。」", "goto": "END" },
          "n_no": { "speaker": "npc",
                    "text": "藍鳳凰掩嘴笑道：「咯咯，膽子這麼小，怎麼行走江湖？」", "goto": "END" } } },
        "d_ying": { "start": "n0", "resume": "n0", "nodes": {
          "n0": { "speaker": "npc",
                  "src_note": "依據 2001-7-21 n528_445091：「找螢月兒她會給你五張麻布，要你送去華山找藍依涵（在華山大廳外右邊）再回來找螢月兒便可以得到五隻蟾蜍」；對白【設計提案】",
                  "text": "瑩月兒正低頭理著腳邊的竹簍，聽見腳步聲抬起頭來：「咦，你是誰？找我有事嗎？」",
                  "choices": [
                    { "id": "c_mabu", "label": "藍鳳凰說，蟾蜍的事託了妳。", "requires": [ { "type": "quest_var", "quest": "q_lanfeng", "var": "toad", "value": "start" } ], "hide_if_locked": true, "goto": "n_m1" },
                    { "id": "c_wait", "label": "華山怎麼走？", "requires": [ { "type": "quest_var", "quest": "q_lanfeng", "var": "toad", "value": "mabu" } ], "hide_if_locked": true, "goto": "n_w" },
                    { "id": "c_back", "label": "麻布已經送到藍依涵手上了。", "requires": [ { "type": "quest_var", "quest": "q_lanfeng", "var": "toad", "value": "lan" } ], "hide_if_locked": true, "goto": "n_b1" },
                    { "id": "c_bye", "label": "沒事，隨口問問。", "goto": "END" } ] },
          "n_m1": { "speaker": "npc",
                    "text": "「是藍姊姊託你來的呀！蟾蜍我早抓好了，五隻都養在這竹簍裡。不過……你能不能先幫我一個忙？」",
                    "choices": [ { "id": "c_what", "label": "什麼忙？妳說。", "goto": "n_m2" } ] },
          "n_m2": { "speaker": "npc",
                    "text": "「這五張麻布，是我答應華山派藍依涵姊姊的。我們是多年的好朋友，她說要做一件練劍穿的短衫。我一個姑娘家，走不慣華山那條路……」",
                    "choices": [ { "id": "c_ok", "label": "交給我吧，我替妳送上山去。", "goto": "n_m3" } ] },
          "n_m3": { "speaker": "npc",
                    "do": [ { "do": "give", "item": "r_lf_mabu", "n": 5 }, { "do": "var", "name": "toad", "value": "mabu" } ],
                    "text": "瑩月兒把五張疊得整整齊齊的麻布交到你手上：「依涵姊姊在華山玉女峰的練武場，正氣堂外頭右手邊。送到了回來找我，蟾蜍就給你。」", "goto": "END" },
          "n_w": { "speaker": "npc",
                   "text": "「從恆山岔路往東南走華陰道，到了華山腳下往北上山，過了山門就是玉女峰練武場。依涵姊姊就在正氣堂外頭右手邊練劍。」", "goto": "END" },
          "n_b1": { "speaker": "npc",
                    "text": "瑩月兒眼睛一亮：「她收到了？她……她有沒有說什麼？」",
                    "choices": [ { "id": "c_say", "label": "她說多謝妳，叫妳得空上山坐坐。",
                                   "do": [ { "do": "give", "item": "r_lf_chanchu", "n": 5 },
                                           { "do": "reward", "rewards": { "fame": 5, "lilian": 15 } },
                                           { "do": "var", "name": "toad", "value": "done" },
                                           { "do": "complete", "obj": "o_yingyueer" } ],
                                   "goto": "n_b2" } ] },
          "n_b2": { "speaker": "npc",
                    "text": "「那就好。」瑩月兒把竹簍遞給你：「這裡頭是五隻蟾蜍，你拿去給藍姊姊吧。路上別隨便掀開蓋子，牠們會噴毒霧的。」", "goto": "END" } } },
        "d_lanyihan": { "start": "n0", "resume": "n0", "nodes": {
          "n0": { "speaker": "npc",
                  "src_note": "依據 2001-07-18 簡介「瑩月兒原來跟華山派的藍依涵是多年的好友」與 2001-7-21 攻略「送去華山找藍依涵（在華山大廳外右邊）」；梁發一句呼應「痴情的梁發」（2001-07-26）；對白【設計提案】",
                  "text": "一名華山女弟子收劍回鞘，擦了擦額上的汗：「你是哪一位？找我有事嗎？」",
                  "choices": [
                    { "id": "c_give", "label": "瑩月兒託我送五張麻布給妳。",
                      "requires": [ { "type": "quest_var", "quest": "q_lanfeng", "var": "toad", "value": "mabu" },
                                    { "type": "has_item", "item": "r_lf_mabu", "n": 5 } ],
                      "do": [ { "do": "take", "item": "r_lf_mabu", "n": 5 },
                              { "do": "var", "name": "toad", "value": "lan" },
                              { "do": "complete", "obj": "o_lanyihan" } ],
                      "goto": "n_g1" },
                    { "id": "c_bye", "label": "沒事，打擾了。", "goto": "END" } ] },
          "n_g1": { "speaker": "npc",
                    "text": "藍依涵接過麻布，摸了又摸：「是月兒織的布！這丫頭，我隨口說要做件練劍穿的短衫，她倒記在心上了。」",
                    "choices": [ { "id": "c_friend", "label": "妳們是怎麼認識的？", "goto": "n_g2" } ] },
          "n_g2": { "speaker": "npc",
                    "text": "「我們小時候是鄰居，一起長大的。後來我上了華山學劍，她留在山下，聽說這陣子在幫一位苗家姑娘採毒物。旁人說五毒教的人碰不得，可月兒心地好，我知道的。」",
                    "choices": [ { "id": "c_word", "label": "要我替妳帶句話給她嗎？", "goto": "n_g3" } ] },
          "n_g3": { "speaker": "npc",
                    "text": "「你替我謝謝她，叫她得空上山來坐坐。」藍依涵頓了頓，又低聲說：「還有……別跟她說梁師兄天天向我打聽她的事。」", "goto": "END" } } },
        "d_return": { "start": "n0", "resume": "n0", "nodes": {
          "n0": { "speaker": "npc",
                  "src_note": "依據 2001-8-2 n820_736977 攻略獎勵「一灌藥以及基本毒術升一級」與 2001-08-10 簡介「藍鳳凰會送非常好的解毒聖品或是教導一些毒術的能力」；恆山派只給解毒藥（台免，later）；對白【設計提案】",
                  "text": "藍鳳凰一見你便跳下大石：「你回來啦！五樣寶貝都抓齊了沒有？」",
                  "choices": [
                    { "id": "c_hand", "label": "蜈蚣、青蛇、蝎子、蜘蛛、蟾蜍，各五隻，都在這裡。",
                      "requires": [ { "type": "has_item", "item": "r_lf_wugong", "n": 5 },
                                    { "type": "has_item", "item": "r_lf_qingshe", "n": 5 },
                                    { "type": "has_item", "item": "r_lf_xiezi", "n": 5 },
                                    { "type": "has_item", "item": "r_lf_zhizhu", "n": 5 },
                                    { "type": "has_item", "item": "r_lf_chanchu", "n": 5 } ],
                      "do": [ { "do": "take", "item": "r_lf_wugong", "n": 5 },
                              { "do": "take", "item": "r_lf_qingshe", "n": 5 },
                              { "do": "take", "item": "r_lf_xiezi", "n": 5 },
                              { "do": "take", "item": "r_lf_zhizhu", "n": 5 },
                              { "do": "take", "item": "r_lf_chanchu", "n": 5 },
                              { "do": "complete", "obj": "o_return" } ],
                      "goto": "n1" },
                    { "id": "c_not", "label": "還差一些，我再去抓。", "goto": "END" } ] },
          "n1": { "speaker": "npc",
                  "text": "藍鳳凰揭開酒罈的封泥，把五毒一樣一樣浸進花蜜酒裡。一股又甜又腥的香氣直衝上來，熏得你頭都有些暈了。",
                  "choices": [ { "id": "c_smell", "label": "好重的味道……", "goto": "n2" } ] },
          "n2": { "speaker": "npc",
                  "text": "「好極了，這一罈五寶花蜜酒成了！你幫了我大忙，我們苗家人可不欠人情。」",
                  "choices": [
                    { "id": "c_heng", "label": "弟子是恆山門下，不敢學使毒的功夫。",
                      "requires": [ { "type": "sect", "sect": "hengshan" } ], "hide_if_locked": true, "goto": "n_heng" },
                    { "id": "c_teach", "label": "藍教主客氣了。",
                      "requires": [ { "type": "any_of", "options": [
                        [ { "type": "no_sect" } ], [ { "type": "sect", "sect": "shaolin" } ], [ { "type": "sect", "sect": "huashan" } ],
                        [ { "type": "sect", "sect": "emei" } ], [ { "type": "sect", "sect": "gumu" } ], [ { "type": "sect", "sect": "lingjiu" } ],
                        [ { "type": "sect", "sect": "quanzhen" } ], [ { "type": "sect", "sect": "wudang" } ], [ { "type": "sect", "sect": "xingxiu" } ],
                        [ { "type": "sect", "sect": "xuedao" } ] ] } ],
                      "hide_if_locked": true, "goto": "n_teach" } ] },
          "n_heng": { "speaker": "npc",
                      "text": "「恆山派的小尼姑？咯咯，定閒師太要是知道我教她的弟子使毒，非找我拚命不可。這五瓶解毒藥你收著，行走江湖總用得著。」", "goto": "END" },
          "n_teach": { "speaker": "npc",
                       "text": "「客氣什麼。我傳你幾手辨毒、使毒的粗淺門道，再送你一瓶解毒藥。往後中了尋常的毒，自己就解得了。下回我的酒又缺五寶了，你再來幫我。」", "goto": "END" } } }
      },
      "outcomes": {
        "default": { "label": "藍鳳凰傳了你幾手毒術",
