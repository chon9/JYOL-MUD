; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JY-Mini OL"
config/description="JY-Mini OL — host-authoritative text wuxia MMO-lite (Godot 4.6.3)"
config/version="0.8.0.0"
run/main_scene="res://ui/boot/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon/icon.png"
config/windows_native_icon="res://assets/icon/icon.ico"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/splash/splash_studio_jianghu.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

FileLog="*res://autoload/file_log.gd"
GameData="*res://autoload/game_data.gd"
SteamManager="*res://autoload/steam_manager.gd"
SaveManager="*res://autoload/save_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
WorldServer="*res://autoload/world_server.gd"
ClientState="*res://autoload/client_state.gd"
SceneRouter="*res://autoload/scene_router.gd"
BgmPlayer="*res://autoload/bgm_player.gd"

[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
shader_compiler/shader_cache/enabled=false

[steam]

initialization/app_data/app_id=480
initialization/processes/initialize_on_startup=false
initialization/processes/embed_callbacks=false
